@page "/processos"
@rendermode InteractiveServer
@inject ProcessoDAO dao;

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>
</div>

<div class="custom-table-card">
    <div class="table-responsive">
        <table class="table align-middle">

            <theead>
                <tr>
                    <th>ID</th>
                    <th>Número</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </theead>

            <tbody>
                <tr>
                    <td>1</td>
                    <td>2026/0001</td>
                    <td>Gustavo</td>
                    <td class="text-truncate">Solicitação de Isenção de IPTU</td>
                    <td>
                        <i class="bi bi-clock"> Pendente</i>
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a href="#" class="btn btn-light border text-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="#" class="btn btn-light border text-danger" title="Excluir">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>2026/0015</td>
                    <td>Mariana</td>
                    <td class="text-truncate">Solicitação de Licença para Construção</td>
                    <td>
                        <i class="bi bi-check-circle text-success"> Aprovado</i>
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a href="#" class="btn btn-light border text-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="#" class="btn btn-light border text-danger" title="Excluir">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>

            </tbody>

        </table>
    </div>
</div>

@code {

}
